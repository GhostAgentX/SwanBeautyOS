# Beauty OS configuration. Copy to .env (never commit it). Every app reads this one file.

# --- Banuba Face AR (required for live AR) ---
# License token from Banuba. Web tokens ship to browsers; ask Banuba to restrict it to your domains.
BANUBA_CLIENT_TOKEN=

# --- AR Design database ---
# Leave empty for local development: an embedded Postgres (PGlite) is created in apps/ar-design/.data.
# Production: any Postgres URL (e.g. Neon via the Vercel Marketplace). Run `npm run db:migrate` on deploy.
DATABASE_URL=

# --- AR Design media storage ---
# Leave empty locally (files go to apps/ar-design/.data/files). Required on Vercel: connect a Blob store.
BLOB_READ_WRITE_TOKEN=

# --- AI modules (optional) ---
# Vercel AI Gateway key (not needed when deployed on Vercel, which uses OIDC automatically).
AI_GATEWAY_API_KEY=
# Gateway model ids. List current ones with: curl -s https://ai-gateway.vercel.sh/v1/models
# Image model for synthetic models (e.g. a provider/image-model id from that list).
BEAUTYOS_IMAGE_MODEL=
# Text model for natural-language look formulation (e.g. an anthropic/claude-* id from that list).
BEAUTYOS_TEXT_MODEL=

# --- URLs ---
# Public origin of AR Design (used in embed snippets). Defaults to the request host.
BEAUTYOS_PUBLIC_URL=
# Where the customer try-on is hosted (used by "Open try-on" and embed snippets).
BEAUTYOS_TRYON_URL=http://localhost:5173
# Try-on defaults when the URL has no ?api= / ?brand=
BEAUTYOS_API_URL=http://localhost:3000
BEAUTYOS_BRAND=swan-beauty
